diff --git a/maia-hdl/projects/common/cs8_12_demux.v b/maia-hdl/projects/common/cs8_12_demux.v
new file mode 100644
index 0000000..3c14b8b
--- /dev/null
+++ b/maia-hdl/projects/common/cs8_12_demux.v
@@ -0,0 +1,31 @@
+// TX counterpart of cs12_8mux (cs8 branch only).
+//
+// Sits between util_ad9361_dac_upack/fifo_rd_data_{0,1} and the TX path
+// (tx_fir_interpolator / DAC FIFO). The mode follows the same convention as
+// on RX: only the I channel of TX1 enabled by the host means cs8.
+//
+//   enable_0 enable_1   behaviour
+//      1        1       bypass, data_out_x = data_in_x
+//      1        0       cs8: data_in_0 = {Q8, I8}, expanded to two 16-bit
+//                       samples, left aligned (the AD9361 DAC uses the 12 MSBs)
+//      0        x       bypass (nothing enabled on TX1)
+//
+// Purely combinational so the data stays aligned with fifo_rd_en/fifo_rd_valid.
+module cs8_12_demux #(
+    parameter DATA_WIDTH = 16
+) (
+    input  [DATA_WIDTH-1:0] data_in_0,
+    input  [DATA_WIDTH-1:0] data_in_1,
+    input                   enable_0,
+    input                   enable_1,
+
+    output [DATA_WIDTH-1:0] data_out_0,
+    output [DATA_WIDTH-1:0] data_out_1
+);
+
+    wire cs8_mode = enable_0 & ~enable_1;
+
+    assign data_out_0 = cs8_mode ? {data_in_0[7:0],  {(DATA_WIDTH-8){1'b0}}} : data_in_0;
+    assign data_out_1 = cs8_mode ? {data_in_0[15:8], {(DATA_WIDTH-8){1'b0}}} : data_in_1;
+
+endmodule
diff --git a/maia-hdl/projects/common/cs8_tx.tcl b/maia-hdl/projects/common/cs8_tx.tcl
new file mode 100644
index 0000000..8510e83
--- /dev/null
+++ b/maia-hdl/projects/common/cs8_tx.tcl
@@ -0,0 +1,16 @@
+# TX complex 8-bit (cs8) mode.
+# Sourced AFTER txfir.tcl: inserts cs8_12_demux between the DAC unpacker and
+# the TX interpolator. Needs the axi_ad9361 patch that forces the Q0 channel to
+# the DMA source when only I0 is enabled (patches/adi-hdl-axi_ad9361-cs8-tx.patch).
+
+ad_disconnect util_ad9361_dac_upack/fifo_rd_data_0 tx_fir_interpolator/data_in_0
+ad_disconnect util_ad9361_dac_upack/fifo_rd_data_1 tx_fir_interpolator/data_in_1
+
+create_bd_cell -type module -reference cs8_12_demux cs8_tx_demux
+
+ad_connect util_ad9361_dac_upack/fifo_rd_data_0 cs8_tx_demux/data_in_0
+ad_connect util_ad9361_dac_upack/fifo_rd_data_1 cs8_tx_demux/data_in_1
+ad_connect axi_ad9361_dac_fifo/din_enable_0     cs8_tx_demux/enable_0
+ad_connect axi_ad9361_dac_fifo/din_enable_1     cs8_tx_demux/enable_1
+ad_connect cs8_tx_demux/data_out_0 tx_fir_interpolator/data_in_0
+ad_connect cs8_tx_demux/data_out_1 tx_fir_interpolator/data_in_1
diff --git a/maia-hdl/projects/common/tb/cs8_12_demux_tb.v b/maia-hdl/projects/common/tb/cs8_12_demux_tb.v
new file mode 100644
index 0000000..1f2fab3
--- /dev/null
+++ b/maia-hdl/projects/common/tb/cs8_12_demux_tb.v
@@ -0,0 +1,50 @@
+// Self-checking testbench for cs8_12_demux (run with xsim, see header of run_tb.sh).
+module cs8_12_demux_tb;
+    reg  [15:0] d0, d1;
+    reg         en0, en1;
+    wire [15:0] o0, o1;
+    integer errors = 0;
+    integer i;
+    reg signed [7:0] si, sq;
+
+    cs8_12_demux dut (.data_in_0(d0), .data_in_1(d1), .enable_0(en0), .enable_1(en1),
+                      .data_out_0(o0), .data_out_1(o1));
+
+    task check(input [15:0] e0, input [15:0] e1);
+        begin
+            #1;
+            if (o0 !== e0 || o1 !== e1) begin
+                errors = errors + 1;
+                $display("FAIL en=%b%b d0=%h d1=%h -> o0=%h o1=%h (exp %h %h)",
+                         en0, en1, d0, d1, o0, o1, e0, e1);
+            end
+        end
+    endtask
+
+    initial begin
+        // cs8: all 65536 packed words
+        en0 = 1; en1 = 0; d1 = 16'hdead;
+        for (i = 0; i < 65536; i = i + 1) begin
+            d0 = i[15:0];
+            check({d0[7:0], 8'h00}, {d0[15:8], 8'h00});
+        end
+        // sign/scale spot checks: I=+127,Q=-128 -> 0x7f00 / 0x8000
+        d0 = {8'h80, 8'h7f}; #1; check(16'h7f00, 16'h8000);
+        // 12-bit view of the output keeps the sign and scales x16
+        si = -1; sq = 1; d0 = {sq, si}; #1; check(16'hff00, 16'h0100);
+
+        // bypass: both enabled
+        en0 = 1; en1 = 1;
+        for (i = 0; i < 4096; i = i + 1) begin
+            d0 = i[15:0] * 16'd13; d1 = ~i[15:0];
+            check(d0, d1);
+        end
+        // bypass: nothing enabled / only Q enabled
+        en0 = 0; en1 = 0; d0 = 16'h1234; d1 = 16'h5678; check(16'h1234, 16'h5678);
+        en0 = 0; en1 = 1; check(16'h1234, 16'h5678);
+
+        if (errors == 0) $display("PASS cs8_12_demux_tb");
+        else             $display("FAILED: %0d errors", errors);
+        $finish;
+    end
+endmodule
